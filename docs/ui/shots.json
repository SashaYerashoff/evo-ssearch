{
  "version": 1,
  "_readme": "Scene manifest for scripts/ui_shots.py. See docs/ui/README.md. Every screenshot in the guides is produced from a scene here — no hand-taken screenshots. React UI only; the legacy template UI is carried for compatibility and is not documented.",

  "defaults": {
    "viewport": {"width": 1920, "height": 1080},
    "device_scale_factor": 1,
    "color_scheme": "dark",
    "locale": "en-US",
    "settle_ms": 1500,
    "media_policy": "placeholder",
    "local_storage": {
      "eva.ui.language.v1": "en",
      "evs_agent_width_preset": "0"
    },
    "redact_always": [
      "video",
      "canvas",
      "[data-eva-media]"
    ],
    "redact": [
      "img[src*='/detections/']",
      "img[src*='/image/']",
      "img[src^='data:image']",
      ".card-thumb img",
      ".vid-sum-thumbnail img",
      ".ag-lightbox img"
    ]
  },

  "scenes": [
    {
      "id": "react-home",
      "ui": "react",
      "auth": "operator",
      "title": "Home",
      "caption": "EVA AI home screen: the perception loop visualisation with the live metadata counter.",
      "path": "/?ui=react",
      "steps": [
        {"wait_for": ".home-screen"},
        {"wait_ms": 1200},
        {"set_text": {"selector": ".hud-timer", "value": "04:12:37"}},
        {"set_text": {"selector": ".hud-count", "value": "18 402"}}
      ],
      "clip": null,
      "output": "docs/ui/assets/react-home.png",
      "used_by": []
    },
    {
      "id": "react-nav-drawer",
      "ui": "react",
      "auth": "operator",
      "title": "Navigation drawer",
      "caption": "The left rail drawer: Archive, Summaries, Probes, plus Settings and sign-out. Sections you have no grant for are absent, not disabled.",
      "path": "/?ui=react",
      "steps": [
        {"wait_for": ".menu-ear"},
        {"click": ".menu-ear"},
        {"wait_for": "#eva-main-menu .menu-item"}
      ],
      "clip": ".menu-shell",
      "output": "docs/ui/assets/react-nav-drawer.png",
      "used_by": []
    },
    {
      "id": "react-appearance-modal",

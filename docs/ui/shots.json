        {"wait_for": ".appearance-toggle"},
        {"click": ".appearance-toggle"},
        {"wait_for": ".appearance-modal"}
      ],
      "clip": ".appearance-modal",
      "output": "docs/ui/assets/react-appearance-modal.png",
      "used_by": []
    },

